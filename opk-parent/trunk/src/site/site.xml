<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/DECORATION/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/DECORATION/1.1.0 http://maven.apache.org/xsd/decoration-1.1.0.xsd">
	<skin>
		<groupId>com.googlecode.fluido-skin</groupId>
		<artifactId>fluido-skin</artifactId>
		<version>1.3</version>
	</skin>
	<custom>
        <fluidoSkin>
            <topBarEnabled>false</topBarEnabled>
            <sideBarEnabled>true</sideBarEnabled>
            <searchEnabled>false</searchEnabled>
            <sourceLineNumbersEnabled>false</sourceLineNumbersEnabled>
        </fluidoSkin>
	</custom>
	<!--
	 ~ Possible positions for the next two tags:
	 ~ left              Left side of the bar just below the site logo
	 ~ right             Right side of the bar just below the site logo
	 ~ navigation-top    Top of the menu
	 ~ navigation-bottom Bottom of the menu
	 ~ none              Suppress the item
	-->
	<version position="right"/>
	<publishDate position="right" format="yyyy-MM-dd"/>
	<bannerLeft>
		<name>${project.name}</name>
		<src>./images/project_logo.png</src>
		<href>${project.url}</href>
	</bannerLeft>
	<bannerRight>
		<src>./images/logo.png</src>
		<href>http://opk.sf.net/</href>
		<alt>OPK Development</alt>
	</bannerRight>
	<poweredBy/>
	<body>
		<breadcrumbs>
			<item name="OPK Development" href="http://opk.sf.net/"/>
		</breadcrumbs>
		<menu name="Overview">
			<item name="Introduction" href="index.html"/>
			<item name="Instant Developer Experience" href="instant_developer_experience.html"/>
		</menu>
		<menu name="Projects">
			<item name="Embedded GlassFish Web Plugin" href="embedded-glassfish-web-plugin/"/>
			<item name="JDBC Populator" href="jdbc-populator/"/>
			<item name="Parent POM" href="opk-parent.html"/>
		</menu>
		<!-- When building the site, this will become a menu with all modules (if available). -->
		<menu ref="modules" inherit="bottom"/>
		<!-- When building the site, this will become a menu with all reports (if available). -->
		<menu ref="reports" inherit="bottom"/>
	</body>
</project>
